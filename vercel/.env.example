# A integração Neon da Vercel configura DATABASE_URL automaticamente.
# Copie a conexão para .env.local apenas se for executar pelo seu computador.
DATABASE_URL="postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/neondb?sslmode=require"
# Opcional: conexão direta para inicializar/migrar o schema; DATABASE_URL pode usar o host -pooler.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@SEU-HOST-DIRETO.neon.tech/neondb?sslmode=require"
